NODE_ENV=production
APP_DOMAIN=hotelapp.charlydob.com
APP_ORIGIN=https://hotelapp.charlydob.com

POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://hotelapp:change-me@postgres:5432/hotelapp?schema=public

SESSION_SECRET=change-me-long-random-value
SESSION_COOKIE_NAME=hotelapp_session
SESSION_TTL_DAYS=14

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-8-chars

BACKEND_PORT=3001
DATA_DIR=/data
EVIDENCE_DIR=/evidence
CICO_FIRMWARE_PUBLISH_TOKEN=replace-with-at-least-32-random-characters

RESERVATION_CACHE_SECONDS=30
CHECKOUT_COOLDOWN_SECONDS=120
PUBLIC_CHECKOUT_RATE_LIMIT=30
PUBLIC_CHECKOUT_RATE_WINDOW_MS=60000

MATCH_TIME_WINDOW_MINUTES=15
MATCH_AUTO_CONFIDENCE_THRESHOLD=0.8
PLATE_COOLDOWN_MINUTES=15
PLATE_PRESENCE_TIMEOUT_MINUTES=30
