{
  "openapi": "3.0.3",
  "info": {
    "title": "CICO Hookbox check-in and display design",
    "version": "1.1.0",
    "description": "Implemented authenticated CICO contract. HTTPS and tenant-admin role required. Device requests require provisioned credentials. The provider is a configurable adapter contract, not an asserted Steinbock API. crowpanel_checkin_real implements 25 physical outputs; electrical commissioning is pending."
  },
  "servers": [
    {
      "url": "https://cico.example.invalid"
    }
  ],
  "paths": {
    "/api/device/v1/hookbox/design": {
      "get": {
        "summary": "Poll immutable design independently of firmware OTA",
        "security": [
          {
            "deviceToken": [],
            "deviceId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignSync"
                }
              }
            }
          },
          "400": {
            "description": "Invalid schema, JSON, format or font/geometry limits"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Hotel, role, Origin or identity authorization denied"
          },
          "404": {
            "description": "Not found in this hotel"
          },
          "409": {
            "description": "Conflicting replay, claim, sequence or draft revision"
          },
          "410": {
            "description": "Session expired"
          },
          "413": {
            "description": "Payload too large"
          },
          "415": {
            "description": "Use application/json"
          },
          "426": {
            "description": "HTTPS required"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Integration/storage unavailable; no release permitted"
          }
        }
      }
    },
