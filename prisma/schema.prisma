generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  username         String?
  usernameNormalized String?    @unique @map("username_normalized")
  passwordHash     String       @map("password_hash")
  displayName      String       @map("display_name")
  globalRole       String?      @map("global_role")
  telegramUserId   String?      @unique @map("telegram_user_id")
  telegramUsername String?      @map("telegram_username")
  telegramLinkedAt DateTime?    @map("telegram_linked_at")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  invitations      Invitation[] @relation("InvitationInviter")
  memberships      Membership[]
  pushPreferences  PushPreference[]
  pushSubscriptions PushSubscription[]
  scheduledPushes  ScheduledPush[]
  sessions         Session[]
  firmwareReleases FirmwareRelease[]
  otaRequests      OtaRequest[]
  deviceCommands   DeviceCommand[]

  @@map("users")
}

model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Tenant {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  active          Boolean          @default(true)
  basicInfo       Json?            @map("basic_info")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  checkoutEvents  CheckoutEvent[]
  detections      Detection[]
  invitations     Invitation[]
  keyIdentifiers  KeyIdentifier[]
  memberships     Membership[]
  modules         TenantModule[]
  occupancyCycles OccupancyCycle[]
  pushPreferences PushPreference[]
  rooms           Room[]
  scheduledPushes ScheduledPush[]
  settings        TenantSettings?
  devices         Device[]

  @@map("tenants")
}

model WebPushConfig {
  id         String   @id
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("web_push_configs")
}

model PushSubscription {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  endpoint      String          @unique
  p256dh        String
  auth          String
  userAgent     String?         @map("user_agent")
  failureCount  Int             @default(0) @map("failure_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  lastSuccessAt DateTime?       @map("last_success_at")
  lastFailureAt DateTime?       @map("last_failure_at")
  disabledAt    DateTime?       @map("disabled_at")
  scheduledPushes ScheduledPush[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([disabledAt])
  @@map("push_subscriptions")
}

model PushPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  enabled       Boolean  @default(true)
  newCheckout   Boolean  @default(true) @map("new_checkout")
  assignedToMe  Boolean  @default(true) @map("assigned_to_me")
  roomCompleted Boolean  @default(false) @map("room_completed")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("push_preferences")
}

model ScheduledPush {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  subscriptionId String?           @map("subscription_id") @db.Uuid
  endpoint       String?
  title          String
  body           String
  url            String
  sendAt         DateTime          @map("send_at")
  status         String            @default("pending")
  error          String?
  httpStatus     Int?              @map("http_status")
  providerReason String?           @map("provider_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  sentAt         DateTime?         @map("sent_at")
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([userId])
  @@index([tenantId])
  @@map("scheduled_pushes")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  alias     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@map("tenant_modules")
}

model TenantSettings {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  reservations  Json     @default("{}")
  frigate       Json     @default("{}")
  cameras       Json     @default("[]")
  stripe        Json     @default("{}")
  telegram      Json     @default("{}")
  notifications Json     @default("{}")
  checkout      Json     @default("{}")
  dashboard     Json     @default("{}")
  integrations  Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Room {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  number             String
  name               String?
  accessCode         String?          @map("access_code")
  active             Boolean          @default(true)
  status             String           @default("unknown")
  lastCheckoutAt     DateTime?        @map("last_checkout_at")
  lastCheckoutSource String?          @map("last_checkout_source")
  checkoutDueDate    DateTime?        @map("checkout_due_date") @db.Date
  checkoutDueSource  String?          @map("checkout_due_source")
  lastCleanedAt      DateTime?        @map("last_cleaned_at")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  checkoutEvents     CheckoutEvent[]
  keys               KeyIdentifier[]
  occupancyCycles    OccupancyCycle[]
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, number])
  @@map("rooms")
}

model KeyIdentifier {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  type       String
  identifier String   @unique
  label      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId])
  @@map("key_identifiers")
}

model CheckoutEvent {
  id                       String          @id @default(uuid()) @db.Uuid
  tenantId                 String          @map("tenant_id") @db.Uuid
  roomId                   String          @map("room_id") @db.Uuid
  occupancyCycleId         String?         @unique @map("occupancy_cycle_id") @db.Uuid
  source                   String
  sourceIdentifier         String?         @map("source_identifier")
  status                   String
  metadata                 Json            @default("{}")
  telegramMessageId        String?         @map("telegram_message_id")
  telegramChatId           String?         @map("telegram_chat_id")
  telegramMessageDeletedAt DateTime?       @map("telegram_message_deleted_at")
  timestamp                DateTime        @default(now())
  tenant                   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room                     Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  occupancyCycle           OccupancyCycle? @relation(fields: [occupancyCycleId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp])
  @@index([tenantId, roomId])
  @@map("checkout_events")
}

model OccupancyCycle {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  roomId          String         @map("room_id") @db.Uuid
  cycleNumber     Int            @map("cycle_number")
  openedAt        DateTime       @default(now()) @map("opened_at")
  createdReason   String         @default("ready") @map("created_reason")
  consumedAt      DateTime?      @map("consumed_at")
  reservationCode String?        @map("reservation_code")
  guestName       String?        @map("guest_name")
  guestEmail      String?        @map("guest_email")
  departureAt     DateTime?      @map("departure_at")
  metadata        Json           @default("{}")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room            Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  checkoutEvent   CheckoutEvent?

  @@unique([tenantId, roomId, cycleNumber])
  @@index([tenantId, roomId, consumedAt])
  @@map("occupancy_cycles")
}

model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  tenantId  String    @map("tenant_id") @db.Uuid
  role      String
  tokenHash String    @unique @map("token_hash")
  invitedBy String?   @map("invited_by") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  inviter   User?     @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: SetNull)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("invitations")
}

model Detection {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  plate                 String
  camera                String
  detectedAt            DateTime  @map("detected_at")
  parkingStatus         String?   @map("parking_status")
  associationStatus     String?   @map("association_status")
  associationMethod     String?   @map("association_method")
  reservationCode       String?   @map("reservation_code")
  room                  String?
  guestName             String?   @map("guest_name")
  guestEmail            String?   @map("guest_email")
  checkInAt             DateTime? @map("check_in_at")
  timeDifferenceMinutes Float?    @map("time_difference_minutes")
  confidence            Float?
  reviewStatus          String?   @map("review_status")
  associationCandidates Json?     @map("association_candidates")
  snapshotUrl           String?   @map("snapshot_url")
  videoUrl              String?   @map("video_url")
  localSnapshotPath     String?   @map("local_snapshot_path")
  localVideoPath        String?   @map("local_video_path")
  notificationSent      Boolean   @default(false) @map("notification_sent")
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, detectedAt])
  @@index([tenantId, plate])
  @@map("detections")
}

model CheckIn {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  reservationCode         String   @map("reservation_code")
  fullName                String   @map("full_name")
  checkInAt               DateTime @map("check_in_at")
  source                  String
  stripeEventId           String?  @map("stripe_event_id")
  stripePaymentIntentId   String?  @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?  @map("stripe_checkout_session_id")
  room                    String?
  guestEmail              String?  @map("guest_email")
  plate                   String?
  parkingValid            Boolean? @map("parking_valid")
  paymentStatus           String?  @map("payment_status")
  metadata                Json     @default("{}")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([tenantId, checkInAt])
  @@index([tenantId, reservationCode])
  @@map("check_ins")
}

model PlateState {
  plate                 String    @id
  tenantId              String?   @map("tenant_id") @db.Uuid
  currentlyPresent      Boolean   @default(false) @map("currently_present")
  firstSeenAt           DateTime? @map("first_seen_at")
  lastSeenAt            DateTime? @map("last_seen_at")
  seenAgainAt           DateTime? @map("seen_again_at")
  releasedAt            DateTime? @map("released_at")
  lastDetectionId       String?   @map("last_detection_id") @db.Uuid
  activeReservationCode String?   @map("active_reservation_code")
  activeRoom            String?   @map("active_room")
  activeGuestName       String?   @map("active_guest_name")
  associationStatus     String?   @map("association_status")
  associationMethod     String?   @map("association_method")
  confidence            Float?
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("plate_states")
}

model Diagnostic {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("diagnostics")
}

// Firmware and UI configuration have independent lifecycles.
enum OtaStatus {
  PENDING
  DOWNLOADING
  VERIFYING
  INSTALLING
  REBOOTING
  HEALTH_CHECK
  SUCCESS
  FAILED
  ROLLED_BACK
}

model Device {
  id                     String   @id @default(uuid()) @db.Uuid
  deviceId               String   @unique @map("device_id")
  tenantId               String?  @map("tenant_id") @db.Uuid
  name                   String
  hardwareModel          String   @map("hardware_model")
  status                 String   @default("OFFLINE")
  currentFirmwareVersion String?  @map("current_firmware_version")
  currentBuildId         String?  @map("current_build_id")
  targetFirmwareVersion  String?  @map("target_firmware_version")
  configVersion          String?  @map("config_version")
  lastSeenAt             DateTime? @map("last_seen_at")
  lastIp                 String?  @map("last_ip")
  lastRssi               Int?     @map("last_rssi")
  uptime                 Int?
  freeHeap               Int?     @map("free_heap")
  psram                  Int?
  lastResetReason        String?  @map("last_reset_reason")
  lastOtaStatus          OtaStatus? @map("last_ota_status")
  lastOtaResult          String?  @map("last_ota_result")
  desiredConfig          Json     @default("{}") @map("desired_config")
  lastRfid               String?  @map("last_rfid")
  lastRfidRaw            String?  @map("last_rfid_raw")
  trapState              String?  @map("trap_state")
  tokenHash              String?  @map("token_hash")
  credentialVersion      Int      @default(0) @map("credential_version")
  credentialRotatedAt    DateTime? @map("credential_rotated_at")
  credentialRevokedAt    DateTime? @map("credential_revoked_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  tenant                 Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  updates                OtaRequest[]
  commands               DeviceCommand[]
  events                 DeviceEvent[]

  @@index([tenantId])
  @@index([lastSeenAt])
  @@index([hardwareModel])
  @@map("devices")
}

model FirmwareRelease {
  id            String   @id @default(uuid()) @db.Uuid
  version       String
  buildId       String   @map("build_id")
  hardwareModel String   @map("hardware_model")
  fileName      String   @map("file_name")
  fileSize      Int      @map("file_size")
  sha256        String
  storagePath   String   @unique @map("storage_path")
  releaseNotes  String   @default("") @map("release_notes")
  status        String   @default("PUBLISHED")
  signature     String?
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  creator       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  updates       OtaRequest[]

  @@unique([hardwareModel, version, buildId])
  @@index([hardwareModel, status])
  @@map("firmware_releases")
}

model OtaRequest {
  id              String    @id @default(uuid()) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  releaseId       String    @map("release_id") @db.Uuid
  status          OtaStatus @default(PENDING)
  progress        Int       @default(0)
  previousVersion String?   @map("previous_version")
  previousBuildId String?   @map("previous_build_id")
  resultCode      String?   @map("result_code")
  requestedBy     String?   @map("requested_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  release         FirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  requester       User?     @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  events          OtaEvent[]

  @@index([deviceId, createdAt])
  @@index([releaseId])
  @@index([status, updatedAt])
  @@map("ota_requests")
}

model OtaEvent {
  id        String    @id @default(uuid()) @db.Uuid
  requestId String    @map("request_id") @db.Uuid
  status    OtaStatus
  progress  Int
  resultCode String?  @map("result_code")
  createdAt DateTime  @default(now()) @map("created_at")
  request   OtaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("ota_events")
}

model DeviceCommand {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  type        String
  payload     Json     @default("{}")
  result      Json?
  status      String   @default("PENDING")
  requestedBy String?  @map("requested_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")
  completedAt DateTime? @map("completed_at")
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  requester   User?    @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
  @@map("device_commands")
}

model DeviceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  type      String
  detail    String?
  uptimeMs  Int      @map("uptime_ms")
  createdAt DateTime @default(now()) @map("created_at")
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("device_events")
}
